# Copy to .env and fill in. .env is git-ignored; never commit it.

# There is no model API key here, and there is no place to put one. Rendering is
# deterministic string substitution; the intelligence is the agent driving the
# CLI, which brings its own model.

# --- Gmail OAuth -----------------------------------------------------------
# See README "Gmail setup". credentials.json is the OAuth client you download
# from Google Cloud; token.json is written on first run. Both are git-ignored.
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# --- Paths -----------------------------------------------------------------
TEMPLATES_DIR=templates/
DATA_DIR=data/
IDENTITY_PATH=data/identity.yaml

# --- Template conformance gate (see AGENTS.md 6.1) -------------------------
# THRESHOLD: fraction of a template's fixed wording a body must reproduce to
# count as sent from that template. Lowering it weakens the gate; do not lower
# it to push one email through.
TEMPLATE_MATCH_THRESHOLD=0.75
TEMPLATE_MATCH_MIN_BLOCK=8

# --- Personal data kept out of every tracked file (see AGENTS.md 12.2) -----
# Your phone number lives here and nowhere else: the resume build injects it
# into the PDF, and the disclosure gate reads it so it can catch the number if
# it ever appears in an email body.
RESUME_PHONE=

# --- Notion (optional, for the notion-publisher skill) ---------------------
NOTION_TOKEN=
NOTION_OUTBOUND_DB_ID=
